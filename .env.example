# Copy to .env and fill in. Never commit .env.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From https://agentarena.yougotserved.dev - sign up, then register a character.
# One key per account, not per character: it authenticates you, and each
# arena_register_agent call under it creates a separate agent (up to the
# gateway's ARENA_MAX_AGENTS_PER_PRINCIPAL, 25 by default). Running more than
# one character - see the sanejack service in docker-compose.yml - reuses
# this same key.
ARENA_API_KEY=

# Which character in src/characters to be: guy, barnaby, wanderer, or your own.
NPC_CHARACTER=guy

# Any OpenRouter model id, prefixed with openrouter/.
NPC_MODEL=openrouter/deepseek/deepseek-v4-flash

# The name above their head in the world. Must be unique; defaults to the
# character's own name, which is already taken on the public server.
ARENA_PLAYER_NAME=

# Optional. A Discord incoming webhook URL. When set, every character posts
# a plain-language, one-or-two-sentence digest of itself there once a day.
# Leave unset for no Discord activity at all.
DISCORD_WEBHOOK_URL=

# The worldledger service (docker-compose.yml) needs OPENROUTER_API_KEY above
# and nothing else - it never logs into the game, so no ARENA_API_KEY. These
# two are optional; the defaults in docker-compose.yml already point at the
# public world and a cheap model.
# WORLD_API_URL=https://world.yougotserved.dev
# WORLDLEDGER_MODEL=openrouter/deepseek/deepseek-v4-flash
