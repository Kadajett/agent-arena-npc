# Copy to .env and fill in. Never commit .env.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From https://agentarena.yougotserved.dev - sign up, then register a character.
# One key per character.
ARENA_API_KEY=
ARENA_MCP_URL=https://mcp.yougotserved.dev/mcp
ARENA_MCP_TIMEOUT_MS=60000
ARENA_RECONNECT_MAX_ATTEMPTS=5
ARENA_RECONNECT_INITIAL_BACKOFF_MS=250

# Select an instance label and its required JSON character sheet. The same
# binary can run any character without a Rust code change. API keys stay in the
# environment, never in the sheet.
NPC_CHARACTER=guy
NPC_CHARACTER_SHEET_PATH=rust-harness/characters/guy.json

# Any OpenRouter model id, prefixed with openrouter/.
NPC_MODEL=openrouter/deepseek/deepseek-v4-flash

# Rust multi-brain models. NPC_MODEL remains a strategist fallback during the
# side-by-side migration.
NPC_STRATEGIST_MODEL=openai/gpt-oss-120b
NPC_TACTICIAN_MODEL=google/gemini-3.1-flash-lite
NPC_STRATEGIST_ENABLED=false
# Opt-in persistent Rig agent loop with ThinkTool and checkpoint JSON.
NPC_STRATEGIST_AGENTIC_LOOP_ENABLED=false
NPC_STRATEGIST_AGENTIC_TIMEOUT_MS=120000
NPC_STRATEGIST_TEMPERATURE=0.4
# OpenRouter counts hidden reasoning and the structured answer against the same
# completion budget. Medium reasoning requires at least 2000; 4000 leaves room
# for the strategist's plan output.
NPC_STRATEGIST_MAX_OUTPUT_TOKENS=4000
NPC_STRATEGIST_TIMEOUT_MS=60000
NPC_STRATEGIST_MIN_INTERVAL_MS=30000
NPC_STRATEGIST_REASONING_ENABLED=true
# One of minimal, low, medium, or high. Known models fail startup when the
# selected effort is unsupported instead of allowing silent provider mapping.
NPC_STRATEGIST_REASONING_EFFORT=medium
# Keep private reasoning out of provider responses and harness logs. Token
# counts and exact OpenRouter charges are still recorded.
NPC_STRATEGIST_REASONING_EXCLUDE=true
# Rig's token-window policy bounds strategist conversation history loaded from
# durable SQLite. The durable record itself is not truncated.
NPC_STRATEGIST_MEMORY_MAX_TOKENS=8000
# Rig rebuilds a character-scoped in-memory vector index from durable SQLite
# facts, relationships, and episode summaries. The default Cargo build includes
# the local-rag feature. The first non-empty recall may download the quantized
# local embedding model (about 24 MB); disable explicitly for lexical fallback.
NPC_LOCAL_RAG_ENABLED=true
NPC_LOCAL_RAG_MINIMUM_SCORE=0.25

# Ceilings, not required polling rates. Tactical decisions remain event-driven.
NPC_TACTICAL_MAX_HZ=5
NPC_IDLE_TACTICAL_HZ=0.2
NPC_TACTICIAN_TEMPERATURE=0.1
NPC_TACTICIAN_MAX_OUTPUT_TOKENS=150
NPC_TACTICIAN_TIMEOUT_MS=5000
# The tactical hot path stays latency-oriented by default. Enabling minimal,
# low, medium, or high reasoning also requires a corresponding larger output
# budget (512, 1000, 2000, or 4000 tokens minimum).
NPC_TACTICIAN_REASONING_ENABLED=false
NPC_TACTICIAN_REASONING_EFFORT=minimal
NPC_TACTICIAN_REASONING_EXCLUDE=true

# Sensitive local debugging only. Default off. When enabled, the exact logical
# Rig request is written under this ignored path with directory mode 0700 and
# file mode 0600. It includes the preamble, bounded history, typed input,
# output schema, and provider parameters, but never credentials.
NPC_LOCAL_MODEL_INPUT_CAPTURE_ENABLED=false
NPC_LOCAL_MODEL_INPUT_CAPTURE_PATH=./var/model-input-captures
# Uses Rig's OpenRouter system-message cache_control marker. Short stable
# prefixes may remain below a provider's minimum and correctly show zero hits.
NPC_OPENROUTER_PROMPT_CACHING_ENABLED=true
NPC_PERCEPTION_INTERVAL_MS=500
NPC_PERCEPTION_MAP_RADIUS=16
NPC_PERCEPTION_INVENTORY_EVERY_CYCLES=10

# Safe rollout defaults. Set shadow to run the model without releasing packets.
# Full mode also requires NPC_ALLOW_LIVE_MUTATION=true.
NPC_TACTICAL_ROLLOUT_MODE=observe_only
NPC_ALLOW_LIVE_MUTATION=false

# Controlled live-packet gate. Zero is independently default-deny. A bounded
# diagnostic uses a positive integer. A persistent deployment must explicitly
# use the literal `unlimited`; other strings fail configuration.
NPC_LIVE_ACTION_BUDGET=0
NPC_LIVE_MAX_ACTIONS_PER_PACKET=1
NPC_LIVE_PACKET_MAX_AGE_MS=1000
NPC_LIVE_EXPECTED_CHARACTER_ID=
NPC_LIVE_EXPECTED_PLAYER_NAME=
# Use one exact scene for a bounded diagnostic. Persistent roaming requires the
# explicit wildcard `*`; even then the observed scene must be known.
NPC_LIVE_ALLOWED_SCENE=

# Used only by `cargo run --bin controlled-packet`; the runtime creates packet
# identity, revision, scene, and timestamp fields around this proposal.
NPC_CONTROLLED_PACKET_JSON=

# Optional positive duration for bounded diagnostics. Leave blank to run until a signal.
NPC_RUN_DURATION_SECONDS=
# Optional hard run ceiling. When set, the runtime also stops if a completed
# provider response has no exact OpenRouter charge.
NPC_RUN_MAX_OPENROUTER_COST_USD=

# Phase 8 will migrate the existing memory into this SQLite path.
NPC_MEMORY_PATH=./var/guy.sqlite

# Structured Rust harness logs.
RUST_LOG=info

# The name above their head in the world. Must be unique; defaults to the
# character's own name, which is already taken on the public server.
ARENA_PLAYER_NAME=
